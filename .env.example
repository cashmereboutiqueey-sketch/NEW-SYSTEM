# Cashmere OS — environment configuration
# Copy to .env and adjust for your machine. Never commit .env.

# Password for the local Docker Postgres container (docker-compose.yml).
# Generate with: node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
POSTGRES_PASSWORD="change-me"

# Must match POSTGRES_PASSWORD above when using docker-compose.
DATABASE_URL="postgresql://cashmere_os:change-me@127.0.0.1:5435/cashmere_os?schema=public"

# A second database that exists only to be wiped by `npm run test:db`. Those
# tests delete sales, stock and journals, so they refuse to run unless this is
# set, names a database ending in _test, and is not DATABASE_URL. Create and
# load it once with:
#   docker compose exec db createdb -U cashmere_os cashmere_os_test
#   npm run test:db:prepare
TEST_DATABASE_URL="postgresql://cashmere_os:change-me@127.0.0.1:5435/cashmere_os_test?schema=public"

# Session signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Default locale for the UI: "ar" or "en"
DEFAULT_LOCALE="ar"
