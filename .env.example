# Cashmere OS — environment configuration
# Copy to .env and adjust for your machine.

DATABASE_URL="postgresql://cashmere:cashmere@localhost:5432/cashmere_os?schema=public"

# Session signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Default locale for the UI: "ar" or "en"
DEFAULT_LOCALE="ar"
