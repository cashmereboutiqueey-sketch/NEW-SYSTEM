# HTTPS for Cashmere OS.
#
# Caddy asks Let's Encrypt for a certificate on first start and renews it
# forever without being asked. Nothing here needs a cron entry, and nothing
# expires quietly at three in the morning eighteen months from now.

{$SITE_ADDRESS} {
	# The app is not published to the host at all — this is the only route in,
	# over the private network Docker gives the three containers.
	reverse_proxy app:3000

	encode gzip zstd

	header {
		# Only ever answer over HTTPS, for two years, and let a browser that
		# has been here once refuse a downgrade before it even asks.
		Strict-Transport-Security "max-age=63072000; includeSubDomains"

		# The system renders no third-party content and embeds nowhere, so
		# these cost nothing and close three whole classes of attack.
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"

		# It answers in Arabic and English, never advertises what it runs on.
		-Server
	}

	# Nothing is said here about caching /api/images/*. The application sets
	# it: "private" for a photograph, because the route is behind the session
	# and a shared cache must not hand it to somebody who is not signed in.
	# This file used to overwrite that with "public" for a year, which also
	# stamped the redirect a signed-out request gets, so a browser that asked
	# once before signing in could keep the login redirect instead of the image.

	log {
		output file /data/access.log {
			roll_size 20mb
			roll_keep 5
		}
		format json
	}
}
