{
  "name": "cashmere-os",
  "version": "0.1.0",
  "description": "",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/next-production.mjs build",
    "start": "node scripts/next-production.mjs start",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy && prisma generate",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "generate": "prisma generate",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:db": "vitest run --config vitest.integration.config.ts",
    "test:db:prepare": "tsx scripts/with-test-database.ts prisma migrate deploy && tsx scripts/with-test-database.ts prisma db seed",
    "test:all": "npm run test && npm run test:db",
    "db:demo": "tsx --conditions=react-server prisma/demo.ts",
    "db:fresh": "prisma migrate deploy && prisma generate && npm run db:seed && npm run db:demo",
    "walkthrough": "tsx --conditions=react-server scripts/walkthrough.ts",
    "lint": "eslint ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cashmereboutiqueey-sketch/NEW-SYSTEM.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/cashmereboutiqueey-sketch/NEW-SYSTEM/issues"
  },
  "homepage": "https://github.com/cashmereboutiqueey-sketch/NEW-SYSTEM#readme",
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "exceljs": "^4.4.0",
    "jose": "^6.2.8",
    "next": "^15.5.25",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.5.4",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.25",
    "postcss": "^8.5.26",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "^0.35.4",
    "nanoid": "^3.3.18",
    "fast-uri": "^3.1.6",
    "mysql2": "^3.24.4",
    "deepmerge-ts": "^8.0.2",
    "uuid": "^11.1.1"
  },
  "private": true,
  "type": "module"
}
