# Cashmere OS — production settings.
#
# Copy to .env on the server and fill in. Never committed: the deploy script
# checks for it and refuses to start without one.

# The address people type. Caddy gets the certificate for exactly this name,
# so it has to resolve to this server before the first start.
SITE_ADDRESS=os.cashmereboutique.shop

# The database password. Generated once on the server, never reused from
# anywhere else, never typed by a person:
#   openssl rand -base64 32
POSTGRES_PASSWORD=

# The password of cashmere_app, the database login the application runs as.
# It reads and writes rows and nothing else; migrations and backups keep using
# the owner above. Set once; the migrate step creates the login and keeps its
# password in step with this:
#   openssl rand -base64 32
APP_DB_PASSWORD=

# Signs the session cookies. A new one logs everybody out, which is the
# correct response to it having leaked:
#   openssl rand -base64 48
AUTH_SECRET=

# Seals the Shopify access token and webhook secret in the database, so a copy
# of the database or a backup does not give them away. Kept here, never in the
# database. Losing it means reconnecting the shop; changing it means running
# scripts/seal-integration-secrets.ts again after reconnecting:
#   openssl rand -base64 32
INTEGRATION_SECRET_KEY=

# Arabic first. The other option is "en".
DEFAULT_LOCALE=ar
