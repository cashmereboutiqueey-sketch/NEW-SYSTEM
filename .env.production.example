# Cashmere OS — production settings.
#
# Copy to .env on the server and fill in. Never committed: the deploy script
# checks for it and refuses to start without one.

# The address people type. Caddy gets the certificate for exactly this name,
# so it has to resolve to this server before the first start.
SITE_ADDRESS=os.cashmereboutique.shop

# The database password. Generated once on the server, never reused from
# anywhere else, never typed by a person:
#   openssl rand -base64 32
POSTGRES_PASSWORD=

# Signs the session cookies. A new one logs everybody out, which is the
# correct response to it having leaked:
#   openssl rand -base64 48
AUTH_SECRET=

# Arabic first. The other option is "en".
DEFAULT_LOCALE=ar
