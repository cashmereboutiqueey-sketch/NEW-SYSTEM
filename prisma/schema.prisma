// ---------------------------------------------------------------------------
// Cashmere OS — data model
//
// Two legal-ish entities (FACTORY, BRAND) that transact with each other at an
// arm's-length transfer price. Accrual accounting throughout. Every monetary
// and quantity field is Decimal — never Float. Percentages are stored as
// fractions (0.14, not 14).
//
// Precision conventions:
//   money      Decimal(18, 4)   EGP, rounded to 2dp only at display
//   rate       Decimal(18, 8)   minute rates and other small per-unit rates
//   quantity   Decimal(18, 4)   metres, pieces, kilograms
//   percent    Decimal(9, 6)    stored as a fraction
//   minutes    Decimal(18, 4)   SMV and capacity minutes
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===========================================================================
// SYSTEM / AUTH / CONFIG
// ===========================================================================

/// Roles name a job. What a role may actually *do* is defined by the
/// capability map in `src/core/permissions.ts`, not by rank — a linear
/// hierarchy cannot express "production sees WIP but never payroll".
enum UserRole {
  OWNER
  ACCOUNTANT
  PRODUCTION
  VIEWER
  BRAND_MANAGER
  MODERATOR
  POS_CASHIER
  WAREHOUSE
  HR
  MARKETING
  FINANCE_APPROVER
  /// Integration connectors (Shopify, biometric, payment). Scoped to the
  /// minimum needed and never able to reach human-user functions.
  SERVICE_ACCOUNT
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         UserRole  @default(VIEWER)
  locale       String    @default("ar")
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  /// Consecutive failed sign-ins, and the moment the account frees up again.
  /// Held on the row rather than in memory so a restart does not hand an
  /// attacker a clean slate, and so a lockout is visible to whoever is asked
  /// why they cannot get in.
  failedLogins Int       @default(0)
  lockedUntil  DateTime?

  /// Set when somebody hands this person a password rather than the person
  /// choosing one: a new account, or a reset. They cannot reach any screen
  /// until they replace it, because a password two people know is not a
  /// password.
  mustChangePassword Boolean @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs        AuditLog[]
  scenarios        Scenario[]
  acknowledgedById Alert[]    @relation("AlertAcknowledgedBy")
  journalsCreated  JournalEntry[] @relation("JournalCreatedBy")
  journalsPosted   JournalEntry[] @relation("JournalPostedBy")
  posSessions      PosSession[]
  posSessionsClosed PosSession[] @relation("PosSessionClosedBy")
  expensesApproved       Expense[]       @relation("ExpenseApprovedBy")
  expensesRaised         Expense[]       @relation("ExpenseCreatedBy")
  purchaseOrdersRaised   PurchaseOrder[] @relation("PurchaseOrderCreatedBy")
  purchaseOrdersApproved PurchaseOrder[] @relation("PurchaseOrderApprovedBy")
  salesOrders      SalesOrder[]   @relation("SalesOrderCreatedBy")
  settlements    Settlement[]
  bankStatements BankStatement[]

  customOrders         CustomOrder[]
  consignmentSales     ConsignmentSale[]     @relation("ConsignmentSoldBy")
  consignorSettlements ConsignorSettlement[] @relation("ConsignorSettlementPaidBy")
  @@map("users")
}

/// Append-only record of who changed what. Never mutate historical records —
/// correct forward with adjusting entries and let this explain why.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityName String
  entityId   String
  before     Json?
  after      Json?
  reason     String?
  createdAt  DateTime @default(now())

  @@index([entityName, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Gap-free per-period document numbering (journals, POs, invoices…).
///
/// The counter is bumped with a single atomic `UPDATE … RETURNING` inside the
/// caller's transaction, so two concurrent postings can never be handed the
/// same number — which counting existing rows would allow.
model DocumentSequence {
  id       String   @id @default(cuid())
  docType  String
  year     Int
  month    Int
  /// Last number issued. The next document takes `lastNumber + 1`.
  lastNumber Int    @default(0)
  updatedAt DateTime @updatedAt

  @@unique([docType, year, month])
  @@map("document_sequences")
}

enum SettingType {
  DECIMAL
  INTEGER
  PERCENT
  STRING
  BOOLEAN
  JSON
}

/// Every configurable number in the system lives here. Rule: no hardcoded
/// rates or magic numbers anywhere in application code.
model Setting {
  id           String      @id @default(cuid())
  key          String      @unique
  value        String
  type         SettingType
  group        String
  labelEn      String
  labelAr      String
  descriptionEn String?
  descriptionAr String?
  updatedAt    DateTime    @updatedAt

  @@index([group])
  @@map("settings")
}

// ===========================================================================
// ENTITIES & FISCAL CALENDAR
// ===========================================================================

enum EntityKind {
  FACTORY
  BRAND
}

model Entity {
  id            String     @id @default(cuid())
  kind          EntityKind @unique
  nameEn        String
  nameAr        String
  baseCurrency  String     @default("EGP")
  createdAt     DateTime   @default(now())

  costCategories     CostCategory[]
  expenses           Expense[]
  minuteRatePeriods  MinuteRatePeriod[]
  capacityConfigs    CapacityConfig[]
  scheduledCashItems ScheduledCashItem[]
  costCenters        CostCenter[]
  journalEntries     JournalEntry[]
  journalLines       JournalLine[]
  locations          Location[]
  inventoryLots      InventoryLot[]
  salesOrders        SalesOrder[]
  employees          Employee[]
  payrollRuns        PayrollRun[]
  garmentUnits GarmentUnit[]
  settlements    Settlement[]
  bankStatements BankStatement[]

  customOrders         CustomOrder[]
  consignmentSales     ConsignmentSale[]
  consignorSettlements ConsignorSettlement[]
  @@map("entities")
}

enum PeriodStatus {
  OPEN
  CLOSED
}

/// Calendar month. Fiscal year starts in January. Timezone Africa/Cairo.
model FiscalPeriod {
  id        String       @id @default(cuid())
  year      Int
  month     Int
  startDate DateTime     @db.Date
  endDate   DateTime     @db.Date
  status    PeriodStatus @default(OPEN)
  closedAt  DateTime?

  minuteRatePeriods MinuteRatePeriod[]
  capacityConfigs   CapacityConfig[]
  expenses          Expense[]
  supplierScores    SupplierScorecard[]
  journalEntries    JournalEntry[]
  payrollRuns       PayrollRun[]

  @@unique([year, month])
  @@index([startDate])
  @@map("fiscal_periods")
}

// ===========================================================================
// GENERAL LEDGER — chart of accounts, journals, tax
//
// The double-entry ledger is the accounting source of truth. `Expense`,
// `SalesOrder`, inventory movements and payroll are subledger documents that
// POST to this ledger; they never replace it.
//
// Two invariants are enforced by database triggers, not only application code
// (see migration `accounting_core_invariants`):
//   1. a journal entry may only reach POSTED if Σ debits = Σ credits
//   2. a POSTED entry and its lines can never be updated or deleted
// ===========================================================================

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  COGS
  EXPENSE
  OTHER_INCOME
  OTHER_EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

/// Which entity's books an account belongs to. `BOTH` means the same account
/// code is used in the Factory and Brand ledgers; the journal line's own
/// entityId is what actually attributes the amount.
enum AccountScope {
  FACTORY
  BRAND
  BOTH
}

/// Chart of accounts. No business calculation may hardcode an account number —
/// code looks up accounts by their semantic flags or by a `settings` key.
model Account {
  id       String        @id @default(cuid())
  code     String        @unique
  nameEn   String
  nameAr   String
  type     AccountType
  normalBalance NormalBalance
  scope    AccountScope  @default(BOTH)

  parentId String?
  parent   Account?  @relation("AccountTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Account[] @relation("AccountTree")

  /// Only leaf accounts may be posted to; parents exist for reporting rollup.
  isPostable Boolean @default(true)
  isActive   Boolean @default(true)

  /// Reporting classification, e.g. "CURRENT_ASSET", "FACTORY_CONVERSION",
  /// "BRAND_VARIABLE_SELLING". Drives statement grouping without inventing an
  /// account number convention that code would then depend on.
  reportingCategory String?

  /// Mirrors the flags already on CostCategory so the ledger, not just the
  /// expense subledger, can answer "what is in the minute-rate numerator" and
  /// "what is in the brand fixed-cost pool" — the two pools the specs warn
  /// must never double-count factory overhead.
  includeInMinuteRate     Boolean @default(false)
  includeInBrandFixedPool Boolean @default(false)

  /// Marks the intercompany receivable/payable and intercompany revenue/COGS
  /// accounts that Group consolidation eliminates.
  isIntercompany Boolean @default(false)

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  journalLines   JournalLine[]
  costCategories CostCategory[]
  payrollLines   PayrollLine[]

  @@index([type, isActive])
  @@index([parentId])
  @@map("accounts")
}

/// Departments/cost centres. Required by the spec so a transaction is
/// traceable beyond entity alone (Factory, Brand, Showroom Alexandria,
/// Cairo store, Marketing, Corporate).
model CostCenter {
  id       String  @id @default(cuid())
  code     String  @unique
  nameEn   String
  nameAr   String
  entityId String?
  entity   Entity? @relation(fields: [entityId], references: [id], onDelete: SetNull)
  isActive Boolean @default(true)
  sortOrder Int    @default(0)

  journalLines JournalLine[]
  employees    Employee[]

  @@map("cost_centers")
}

/// Versioned by effective date. A posted transaction keeps the rate that was
/// in force when it posted — changing VAT next year must not restate history.
model TaxRate {
  id            String    @id @default(cuid())
  code          String
  nameEn        String
  nameAr        String
  /// Stored as a fraction: 0.14, not 14.
  rate          Decimal   @db.Decimal(9, 6)
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())

  @@unique([code, effectiveFrom])
  @@index([code, effectiveFrom, effectiveTo])
  @@map("tax_rates")
}

/// There is deliberately no REVERSED state. Marking an original entry as
/// reversed would mean updating a posted entry, which the immutability trigger
/// forbids. "Has been reversed" is derived from the `reversedBy` back-relation.
enum JournalStatus {
  DRAFT
  PENDING_REVIEW
  POSTED
}

/// What produced this entry. Manual entries are the exception; almost every
/// journal is the ledger shadow of a subledger document.
enum JournalSourceType {
  MANUAL
  EXPENSE
  EXPENSE_PAYMENT
  SUPPLIER_INVOICE
  GOODS_RECEIPT
  MATERIAL_ISSUE
  PRODUCTION_OUTPUT
  TRANSFER_INVOICE
  SALES_ORDER
  SALES_RETURN
  PAYMENT
  PAYROLL
  DEPRECIATION
  ACCRUAL
  OPENING_BALANCE
  ADJUSTMENT
}

model JournalEntry {
  id          String        @id @default(cuid())
  entryNumber String        @unique
  entityId    String
  entity      Entity        @relation(fields: [entityId], references: [id])
  fiscalPeriodId String
  fiscalPeriod   FiscalPeriod @relation(fields: [fiscalPeriodId], references: [id])
  status      JournalStatus @default(DRAFT)

  postingDate DateTime @db.Date
  memo        String?
  currency    String   @default("EGP")

  /// Which subledger document this entry records.
  sourceType JournalSourceType @default(MANUAL)
  sourceId   String?

  /// Corrections never edit a posted entry — they post a reversal that points
  /// back at the original, and the original points forward at its reversal.
  reversesEntryId String?       @unique
  reversesEntry   JournalEntry? @relation("JournalReversal", fields: [reversesEntryId], references: [id])
  reversedBy      JournalEntry? @relation("JournalReversal")
  reversalReason  String?

  createdByUserId String?
  createdBy       User?     @relation("JournalCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  postedByUserId  String?
  postedBy        User?     @relation("JournalPostedBy", fields: [postedByUserId], references: [id], onDelete: SetNull)
  postedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines JournalLine[]

  @@index([entityId, postingDate])
  @@index([fiscalPeriodId, status])
  @@index([sourceType, sourceId])
  @@map("journal_entries")
}

/// One side of an entry. `debit` and `credit` are separate columns rather than
/// one signed amount: a CHECK constraint then guarantees exactly one of them
/// is non-zero and neither is negative, which a signed column cannot express.
///
/// The dimension columns exist so drilldown works without exploding the chart
/// of accounts into thousands of near-duplicate codes.
model JournalLine {
  id             String       @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  lineNumber     Int
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id])

  debit  Decimal @default(0) @db.Decimal(18, 4)
  credit Decimal @default(0) @db.Decimal(18, 4)

  // --- dimensions ---
  entityId     String
  entity       Entity      @relation(fields: [entityId], references: [id])
  costCenterId String?
  costCenter   CostCenter? @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  supplierId   String?
  supplier     Supplier?   @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  customerId   String?
  customer     Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  styleId      String?
  style        Style?      @relation(fields: [styleId], references: [id], onDelete: SetNull)
  variantId    String?
  variant      Variant?    @relation(fields: [variantId], references: [id], onDelete: SetNull)

  /// The tax rate actually applied when this line posted, frozen here so a
  /// later VAT change cannot restate it.
  appliedTaxRate Decimal? @db.Decimal(9, 6)

  description String?
  bankStatementLine BankStatementLine?

  @@unique([journalEntryId, lineNumber])
  @@index([accountId])
  @@index([entityId])
  @@index([supplierId])
  @@index([customerId])
  @@map("journal_lines")
}

// ===========================================================================
// REFERENCE DATA — seeded, editable, never enums in code
// ===========================================================================

/// SKU convention: [STYLENAME]-[COLORCODE]-[SIZE]
model ColorCode {
  id        String    @id @default(cuid())
  code      String    @unique
  nameEn    String
  nameAr    String
  hex       String?
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)

  variants Variant[]

  @@map("color_codes")
}

model SizeCode {
  id        String    @id @default(cuid())
  code      String    @unique
  nameEn    String
  nameAr    String
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  /// Consumption multiplier relative to the BOM base size (base = 1.0).
  consumptionFactor Decimal @default(1.0) @db.Decimal(9, 6)

  variants Variant[]

  @@map("size_codes")
}

enum UomKind {
  LENGTH
  MASS
  PIECE
  AREA
}

model UnitOfMeasure {
  id     String  @id @default(cuid())
  code   String  @unique
  nameEn String
  nameAr String
  kind   UomKind

  materials Material[]

  @@map("units_of_measure")
}

// ===========================================================================
// ACCRUAL ACCOUNTING — expenses, payables
// ===========================================================================

enum CostBehaviour {
  FIXED
  VARIABLE
  SEMI_VARIABLE
}

/// The `includeInMinuteRate` flag is critical: it decides what lands in the
/// numerator of the minute rate. Materials, financing costs and brand-side
/// costs must be excluded or fabric gets counted twice.
model CostCategory {
  id                  String        @id @default(cuid())
  entityId            String
  entity              Entity        @relation(fields: [entityId], references: [id], onDelete: Cascade)
  code                String
  nameEn              String
  nameAr              String
  behaviour           CostBehaviour @default(FIXED)
  /// Feeds `total_factory_monthly_cost` (the minute-rate numerator).
  includeInMinuteRate Boolean       @default(false)
  /// Feeds the brand-side fixed cost pool used by break-even.
  includeInBrandFixedPool Boolean   @default(false)
  isActive            Boolean       @default(true)
  sortOrder           Int           @default(0)

  /// The ledger account expenses in this category post to. Without it the
  /// expense subledger could not reach the general ledger at all.
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: Restrict)

  expenses           Expense[]
  scheduledCashItems ScheduledCashItem[]

  @@unique([entityId, code])
  @@map("cost_categories")
}

enum ExpenseStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

/// Accrual: the expense exists from `incurredDate`, regardless of payment.
/// `paidAmount` is maintained from ExpensePayment rows.
model Expense {
  id             String        @id @default(cuid())
  entityId       String
  entity         Entity        @relation(fields: [entityId], references: [id])
  costCategoryId String
  costCategory   CostCategory  @relation(fields: [costCategoryId], references: [id])
  fiscalPeriodId String
  fiscalPeriod   FiscalPeriod  @relation(fields: [fiscalPeriodId], references: [id])
  supplierId     String?
  supplier       Supplier?     @relation(fields: [supplierId], references: [id])

  description    String
  reference      String?
  amount         Decimal       @db.Decimal(18, 4)
  vatAmount      Decimal       @default(0) @db.Decimal(18, 4)
  incurredDate   DateTime      @db.Date
  dueDate        DateTime      @db.Date
  paidAmount     Decimal       @default(0) @db.Decimal(18, 4)
  status         ExpenseStatus @default(UNPAID)

  /// Who raised it, so the approver can be checked against them.
  createdByUserId String?
  createdBy       User?   @relation("ExpenseCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  /// Approval is a separate question from payment. An expense can be approved
  /// and unpaid, or paid without ever needing approval because it was small.
  /// Null on both means nobody has looked at it yet.
  approvedByUserId String?
  approvedBy       User?     @relation("ExpenseApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  approvedAt       DateTime?
  /// Why it was sent back, when it was. Cleared if it is later approved.
  rejectedAt       DateTime?
  rejectionReason  String?

  /// Adjusting entries reference the original instead of editing it.
  adjustsExpenseId String?
  adjustsExpense   Expense?  @relation("ExpenseAdjustment", fields: [adjustsExpenseId], references: [id])
  adjustments      Expense[] @relation("ExpenseAdjustment")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments ExpensePayment[]

  @@index([entityId, incurredDate])
  @@index([dueDate, status])
  @@index([fiscalPeriodId])
  @@index([approvedAt])
  @@index([createdByUserId])
  @@map("expenses")
}

/// How money left the business.
///
/// The account is not the whole story. InstaPay, a card and a manual transfer
/// all leave the same bank account, but knowing which one was used is what
/// makes a bank statement reconcilable line by line.
enum PayoutMethod {
  CASH
  BANK_TRANSFER
  INSTAPAY
  CARD
}

model ExpensePayment {
  id        String   @id @default(cuid())
  expenseId String
  expense   Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(18, 4)
  paidDate  DateTime @db.Date
  /// Was a free string, which meant nothing stopped a typo from becoming a
  /// category nobody could report on.
  method    PayoutMethod @default(BANK_TRANSFER)
  reference String?
  createdAt DateTime @default(now())

  @@index([expenseId])
  @@index([paidDate])
  @@map("expense_payments")
}

// ===========================================================================
// CAPACITY & THE MINUTE RATE — the spine
// ===========================================================================

model ProductionLine {
  id        String  @id @default(cuid())
  code      String  @unique
  nameEn    String
  nameAr    String
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  operators        Operator[]
  capacityConfigs  CapacityConfig[]
  styleOperations  StyleOperation[]
  stageLogs        ProductionStageLog[]
  reworkRecords    ReworkRecord[]

  @@map("production_lines")
}

model Operator {
  id         String          @id @default(cuid())
  code       String          @unique
  name       String
  lineId     String?
  line       ProductionLine? @relation(fields: [lineId], references: [id], onDelete: SetNull)
  hiredAt    DateTime?       @db.Date
  isActive   Boolean         @default(true)

  /// The HR record behind this operator. Sewing operators are employees too;
  /// keeping one employee master avoids two versions of the same person's pay.
  employeeId String?   @unique
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  productivity OperatorProductivity[]

  @@index([lineId])
  @@map("operators")
}

/// Capacity inputs, versioned per period. Utilisation and efficiency are kept
/// SEPARATE on purpose:
///   utilisation = share of available minutes actually booked with orders
///                 (a sales problem)
///   efficiency  = earned SMV minutes / clocked minutes when working
///                 (a shop-floor problem)
///   productive_minutes = gross × utilisation × efficiency
model CapacityConfig {
  id             String          @id @default(cuid())
  entityId       String
  entity         Entity          @relation(fields: [entityId], references: [id])
  fiscalPeriodId String
  fiscalPeriod   FiscalPeriod    @relation(fields: [fiscalPeriodId], references: [id])
  lineId         String?
  line           ProductionLine? @relation(fields: [lineId], references: [id], onDelete: SetNull)

  operators      Int
  workingDays    Decimal @db.Decimal(9, 4)
  hoursPerDay    Decimal @db.Decimal(9, 4)
  utilisationRate Decimal @db.Decimal(9, 6)
  efficiencyRate  Decimal @db.Decimal(9, 6)

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Uniqueness is enforced by two PARTIAL indexes added in the migration,
  /// because a plain UNIQUE(entity, period, line) does not constrain the
  /// factory-wide row: in Postgres NULL never equals NULL, so unlimited
  /// duplicate factory-wide configs would slip through.
  ///   - one row per (entity, period) where line_id IS NULL   → factory-wide
  ///   - one row per (entity, period, line) where NOT NULL    → per line
  @@index([entityId, fiscalPeriodId])
  @@map("capacity_configs")
}

enum MinuteRateStatus {
  /// Budgeted, month still open. Marked provisional in the UI.
  PROVISIONAL
  /// Month closed on actuals. Immutable — never recompute a locked period.
  LOCKED
}

/// One row per entity per month. Historical production orders point at the
/// row that was in effect when they were costed, so recalculating this month
/// can never retroactively change last quarter's margins.
model MinuteRatePeriod {
  id             String           @id @default(cuid())
  entityId       String
  entity         Entity           @relation(fields: [entityId], references: [id])
  fiscalPeriodId String
  fiscalPeriod   FiscalPeriod     @relation(fields: [fiscalPeriodId], references: [id])
  status         MinuteRateStatus @default(PROVISIONAL)

  // --- inputs (copied in, not referenced, so the row is self-contained) ---
  operators             Int
  workingDays           Decimal @db.Decimal(9, 4)
  hoursPerDay           Decimal @db.Decimal(9, 4)
  utilisationRate       Decimal @db.Decimal(9, 6)
  efficiencyRate        Decimal @db.Decimal(9, 6)
  totalConversionCost   Decimal @db.Decimal(18, 4)
  /// External CMT revenue credited against the factory cost pool, so selling
  /// idle minutes visibly lowers the rate the brand pays.
  cmtRevenueCredit      Decimal @default(0) @db.Decimal(18, 4)

  // --- outputs (stored, not recomputed on read — traceability) ---
  netCostPool             Decimal @db.Decimal(18, 4)
  grossAvailableMinutes   Decimal @db.Decimal(18, 4)
  productiveMinutes       Decimal @db.Decimal(18, 4)
  actualMinuteRate        Decimal @db.Decimal(18, 8)
  fullCapacityMinuteRate  Decimal @db.Decimal(18, 8)
  idlePenaltyPerMinute    Decimal @db.Decimal(18, 8)
  idleMinutes             Decimal @db.Decimal(18, 4)

  calculatedAt DateTime  @default(now())
  lockedAt     DateTime?

  components       MinuteRateComponent[]
  productionOrders ProductionOrder[]
  costSnapshots    CostSnapshot[]
  cmtQuotes        CMTQuote[]

  @@unique([entityId, fiscalPeriodId])
  @@map("minute_rate_periods")
}

/// Drill-down for the minute rate: which cost categories contributed what.
model MinuteRateComponent {
  id                 String           @id @default(cuid())
  minuteRatePeriodId String
  minuteRatePeriod   MinuteRatePeriod @relation(fields: [minuteRatePeriodId], references: [id], onDelete: Cascade)
  costCategoryCode   String
  costCategoryName   String
  amount             Decimal          @db.Decimal(18, 4)
  expenseCount       Int              @default(0)

  @@index([minuteRatePeriodId])
  @@map("minute_rate_components")
}

/// Forward-looking capacity: minutes booked against a period before it starts,
/// so idle capacity is visible in advance and can be sold as CMT.
enum BookingSource {
  PRODUCTION_ORDER
  CMT_ORDER
  MAINTENANCE
  SAMPLING
}

model CapacityBooking {
  id                String        @id @default(cuid())
  fiscalPeriodId    String
  source            BookingSource
  productionOrderId String?
  productionOrder   ProductionOrder? @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  cmtOrderId        String?
  cmtOrder          CMTOrder?     @relation(fields: [cmtOrderId], references: [id], onDelete: Cascade)
  minutes           Decimal       @db.Decimal(18, 4)
  bookedAt          DateTime      @default(now())
  notes             String?

  @@index([fiscalPeriodId])
  @@map("capacity_bookings")
}

// ===========================================================================
// SUPPLIERS & MATERIALS
// ===========================================================================

model Supplier {
  id            String  @id @default(cuid())
  code          String  @unique
  nameEn        String
  nameAr        String
  contactPerson String?
  phone         String?
  email         String?
  /// Days of credit granted. Feeds the CCC's supplier_credit_days.
  creditDays    Int     @default(0)
  isActive      Boolean @default(true)
  notes         String?

  materials       Material[]
  purchaseOrders  PurchaseOrder[]
  expenses        Expense[]
  scorecards      SupplierScorecard[]
  journalLines    JournalLine[]

  @@map("suppliers")
}

/// Rated per period so a supplier's record is a trend, not an opinion.
/// Scores are 1–5. Delivery and price scores can be computed from data;
/// quality is entered from QC outcomes.
model SupplierScorecard {
  id             String       @id @default(cuid())
  supplierId     String
  supplier       Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  fiscalPeriodId String
  fiscalPeriod   FiscalPeriod @relation(fields: [fiscalPeriodId], references: [id])

  priceScore     Decimal @db.Decimal(4, 2)
  qualityScore   Decimal @db.Decimal(4, 2)
  deliveryScore  Decimal @db.Decimal(4, 2)
  overallScore   Decimal @db.Decimal(4, 2)

  /// Supporting evidence for the scores.
  onTimeDeliveryRate Decimal? @db.Decimal(9, 6)
  defectRate         Decimal? @db.Decimal(9, 6)
  avgPriceVariance   Decimal? @db.Decimal(9, 6)
  notes              String?
  createdAt          DateTime @default(now())

  @@unique([supplierId, fiscalPeriodId])
  @@map("supplier_scorecards")
}

enum MaterialType {
  FABRIC
  TRIM
  PACKAGING
  CONSUMABLE
}

model Material {
  id           String        @id @default(cuid())
  code         String        @unique
  nameEn       String
  nameAr       String
  type         MaterialType
  uomId        String
  uom          UnitOfMeasure @relation(fields: [uomId], references: [id])
  supplierId   String?
  supplier     Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  /// Current purchase price, ex-VAT, before freight and duty.
  basePrice    Decimal @db.Decimal(18, 4)
  freightPct   Decimal @default(0) @db.Decimal(9, 6)
  dutyPct      Decimal @default(0) @db.Decimal(9, 6)

  /// Minimum order quantity and roll/pack size — drives the MOQ warning when
  /// a production order needs less than the smallest purchasable quantity.
  moq          Decimal? @db.Decimal(18, 4)
  packSize     Decimal? @db.Decimal(18, 4)
  leadTimeDays Int      @default(0)

  /// Reorder point for the low-stock alert.
  reorderPoint Decimal? @db.Decimal(18, 4)

  colorCode    String?
  composition  String?
  gsm          Decimal? @db.Decimal(9, 2)
  widthCm      Decimal? @db.Decimal(9, 2)
  isActive     Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  priceHistory   MaterialPriceHistory[]
  bomLines       StyleBomLine[]
  poLines        PurchaseOrderLine[]
  issues         MaterialIssue[]
  scrapRecords   ScrapRecord[]
  inventoryLots  InventoryLot[]

  @@index([type])
  @@map("materials")
}

/// Append-only. Changing a price today must not change any historical order.
model MaterialPriceHistory {
  id            String   @id @default(cuid())
  materialId    String
  material      Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  basePrice     Decimal  @db.Decimal(18, 4)
  freightPct    Decimal  @db.Decimal(9, 6)
  dutyPct       Decimal  @db.Decimal(9, 6)
  effectiveCost Decimal  @db.Decimal(18, 4)
  effectiveFrom DateTime @db.Date
  source        String?
  createdAt     DateTime @default(now())

  @@index([materialId, effectiveFrom])
  @@map("material_price_history")
}

enum PurchaseOrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  poNumber     String              @unique
  supplierId   String
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  status       PurchaseOrderStatus @default(DRAFT)

  /// Who raised it. Needed on the row and not only in the audit log: the
  /// rule is that the approver is not the person who asked, and that cannot
  /// be checked against a log entry somebody may have to go looking for.
  createdByUserId String?
  createdBy       User?   @relation("PurchaseOrderCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  /// Committing the business to buy. Until this is set the order is a
  /// proposal, and goods cannot be received against it.
  approvedByUserId String?
  approvedBy       User?     @relation("PurchaseOrderApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  approvedAt       DateTime?
  rejectedAt       DateTime?
  rejectionReason  String?
  orderDate    DateTime            @db.Date
  expectedDate DateTime?           @db.Date
  creditDays   Int                 @default(0)
  dueDate      DateTime?           @db.Date
  notes        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  lines    PurchaseOrderLine[]
  receipts GoodsReceipt[]

  @@index([status, expectedDate])
  @@index([approvedAt])
  @@index([createdByUserId])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  materialId      String
  material        Material      @relation(fields: [materialId], references: [id])
  quantity        Decimal       @db.Decimal(18, 4)
  unitPrice       Decimal       @db.Decimal(18, 4)
  freightPct      Decimal       @default(0) @db.Decimal(9, 6)
  dutyPct         Decimal       @default(0) @db.Decimal(9, 6)
  effectiveCost   Decimal       @db.Decimal(18, 4)
  receivedQty     Decimal       @default(0) @db.Decimal(18, 4)

  receiptLines GoodsReceiptLine[]

  @@index([purchaseOrderId])
  @@map("purchase_order_lines")
}

model GoodsReceipt {
  id              String        @id @default(cuid())
  receiptNumber   String        @unique
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  receivedDate    DateTime      @db.Date
  invoiceRef      String?
  notes           String?
  createdAt       DateTime      @default(now())

  lines GoodsReceiptLine[]

  @@index([receivedDate])
  @@map("goods_receipts")
}

/// Purchase price variance is captured here: the PO said one price, the
/// invoice said another. `priceVariance` = (actual − ordered) × quantity.
model GoodsReceiptLine {
  id                  String            @id @default(cuid())
  goodsReceiptId      String
  goodsReceipt        GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderLineId String
  purchaseOrderLine   PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id])

  quantity            Decimal @db.Decimal(18, 4)
  acceptedQty         Decimal @db.Decimal(18, 4)
  rejectedQty         Decimal @default(0) @db.Decimal(18, 4)
  orderedUnitPrice    Decimal @db.Decimal(18, 4)
  actualUnitPrice     Decimal @db.Decimal(18, 4)
  actualEffectiveCost Decimal @db.Decimal(18, 4)
  priceVariance       Decimal @db.Decimal(18, 4)
  priceVariancePct    Decimal @db.Decimal(9, 6)

  inventoryLot InventoryLot?

  @@index([goodsReceiptId])
  @@map("goods_receipt_lines")
}

// ===========================================================================
// PRODUCT — collections, styles, BOM, SMV, variants
// ===========================================================================

model Collection {
  id        String    @id @default(cuid())
  code      String    @unique
  nameEn    String
  nameAr    String
  season    String
  year      Int
  startDate DateTime? @db.Date
  endDate   DateTime? @db.Date
  isActive  Boolean   @default(true)

  styles    Style[]
  campaigns Campaign[]

  @@map("collections")
}

model Style {
  id           String     @id @default(cuid())
  /// The STYLENAME part of the SKU. Uppercase, no dashes.
  code         String     @unique
  nameEn       String
  nameAr       String
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id])

  /// Waste is measured, not assumed. `plannedWasteRate` is used for costing;
  /// `actualWasteRateTrailing` is computed from real cutting tickets and
  /// compared against it to flag drift.
  plannedWasteRate        Decimal  @default(0) @db.Decimal(9, 6)
  actualWasteRateTrailing Decimal? @db.Decimal(9, 6)
  wasteVarianceFlagged    Boolean  @default(false)
  wasteLastComputedAt     DateTime?

  /// Sum of StyleOperation.smvMinutes — stored for query speed, always
  /// reconcilable against the operation breakdown.
  totalSmvMinutes Decimal @default(0) @db.Decimal(18, 4)

  retailPrice     Decimal? @db.Decimal(18, 4)
  targetMarginPct Decimal? @db.Decimal(9, 6)
  isActive        Boolean  @default(true)

  /// The photograph a person recognises the garment by. Stored as a file name
  /// rather than the bytes: a database that carries every product shot makes
  /// every backup and restore slower for no gain, and these are not secrets.
  imageName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bomLines         StyleBomLine[]
  operations       StyleOperation[]
  variants         Variant[]
  costSnapshots    CostSnapshot[]
  productionOrders ProductionOrder[]
  journalLines     JournalLine[]
  campaigns        Campaign[]

  @@index([collectionId])
  @@map("styles")
}

model StyleBomLine {
  id         String   @id @default(cuid())
  styleId    String
  style      Style    @relation(fields: [styleId], references: [id], onDelete: Cascade)
  materialId String
  material   Material @relation(fields: [materialId], references: [id])

  /// Per garment, at the base size, before waste.
  standardConsumption Decimal @db.Decimal(18, 4)
  /// Optional per-line waste override; falls back to the style's rate.
  wasteRateOverride   Decimal? @db.Decimal(9, 6)
  notes               String?
  sortOrder           Int      @default(0)

  @@unique([styleId, materialId])
  @@map("style_bom_lines")
}

/// SMV built bottom-up from operations, so the minute count is drillable.
model StyleOperation {
  id         String          @id @default(cuid())
  styleId    String
  style      Style           @relation(fields: [styleId], references: [id], onDelete: Cascade)
  lineId     String?
  line       ProductionLine? @relation(fields: [lineId], references: [id], onDelete: SetNull)
  sequence   Int
  nameEn     String
  nameAr     String
  smvMinutes Decimal         @db.Decimal(18, 4)
  machineType String?

  @@unique([styleId, sequence])
  @@map("style_operations")
}

/// SKU = [STYLE.code]-[ColorCode.code]-[SizeCode.code]
model Variant {
  id          String    @id @default(cuid())
  styleId     String
  style       Style     @relation(fields: [styleId], references: [id], onDelete: Cascade)
  colorCodeId String
  colorCode   ColorCode @relation(fields: [colorCodeId], references: [id])
  sizeCodeId  String
  sizeCode    SizeCode  @relation(fields: [sizeCodeId], references: [id])
  sku         String    @unique
  barcode     String?

  /// A shot of this particular colour. Optional: most styles need one photo,
  /// and falling back to the style's own is better than an empty square.
  imageName   String?
  shopifyVariantId String?
  isActive    Boolean   @default(true)

  productionOrderLines ProductionOrderLine[]
  salesOrderLines      SalesOrderLine[]
  inventoryLots        InventoryLot[]
  returns              Return[]
  journalLines         JournalLine[]
  garmentUnits         GarmentUnit[]

  customOrders CustomOrder[]
  @@unique([styleId, colorCodeId, sizeCodeId])
  @@index([sku])
  @@map("variants")
}

// ===========================================================================
// COST SNAPSHOTS — immutable
// ===========================================================================

/// Frozen at production-order confirmation. Append-only: later changes to
/// fabric prices, the minute rate or the SMV create a NEW snapshot and never
/// mutate this one. This is the record that keeps historical margins honest.
model CostSnapshot {
  id                 String           @id @default(cuid())
  styleId            String
  style              Style            @relation(fields: [styleId], references: [id])
  minuteRatePeriodId String
  minuteRatePeriod   MinuteRatePeriod @relation(fields: [minuteRatePeriodId], references: [id])

  /// Frozen inputs.
  minuteRate       Decimal @db.Decimal(18, 8)
  fullCapacityRate Decimal @db.Decimal(18, 8)
  smvMinutes       Decimal @db.Decimal(18, 4)
  wasteRate        Decimal @db.Decimal(9, 6)
  /// A markup, not a margin: the transfer price is `factoryTotalCost x (1 + this)`.
  /// 0.25 here earns a 20% margin. Both are reported; only one is stored.
  factoryMarkupPct Decimal @db.Decimal(9, 6)

  /// Frozen outputs.
  fabricCost         Decimal @db.Decimal(18, 4)
  trimCost           Decimal @db.Decimal(18, 4)
  materialCost       Decimal @db.Decimal(18, 4)
  cmtCost            Decimal @db.Decimal(18, 4)
  factoryTotalCost   Decimal @db.Decimal(18, 4)
  transferPrice      Decimal @db.Decimal(18, 4)
  /// (actualMinuteRate − fullCapacityMinuteRate) × smvMinutes
  idleCapacityPenalty Decimal @db.Decimal(18, 4)

  markupBelowArmsLength Boolean @default(false)
  approvedByUserId      String?
  approvalNote          String?

  reason    String?
  createdAt DateTime @default(now())

  lines            CostSnapshotLine[]
  productionOrders ProductionOrder[]
  transferredLots  InventoryLot[]

  @@index([styleId, createdAt])
  @@map("cost_snapshots")
}

model CostSnapshotLine {
  id             String       @id @default(cuid())
  costSnapshotId String
  costSnapshot   CostSnapshot @relation(fields: [costSnapshotId], references: [id], onDelete: Cascade)

  materialId          String
  materialCode        String
  materialNameEn      String
  materialNameAr      String
  materialType        MaterialType
  standardConsumption Decimal      @db.Decimal(18, 4)
  wasteRate           Decimal      @db.Decimal(9, 6)
  effectiveConsumption Decimal     @db.Decimal(18, 4)
  unitCost            Decimal      @db.Decimal(18, 4)
  lineCost            Decimal      @db.Decimal(18, 4)

  @@index([costSnapshotId])
  @@map("cost_snapshot_lines")
}

// ===========================================================================
// PRODUCTION — orders, cutting, stages, QC, rework, scrap
// ===========================================================================

enum ProductionOrderStatus {
  DRAFT
  CONFIRMED
  IN_PRODUCTION
  COMPLETED
  CANCELLED
}

enum ProductionStage {
  CUTTING
  SEWING
  FINISHING
  QC
  PACKING
}

/// Planned vs actual is carried on the order itself so the system can answer
/// "why did this cost more than we said it would", not just "what did it cost".
model ProductionOrder {
  id          String                @id @default(cuid())
  orderNumber String                @unique
  styleId     String
  style       Style                 @relation(fields: [styleId], references: [id])
  status      ProductionOrderStatus @default(DRAFT)

  costSnapshotId String?
  costSnapshot   CostSnapshot? @relation(fields: [costSnapshotId], references: [id])
  minuteRatePeriodId String?
  minuteRatePeriod   MinuteRatePeriod? @relation(fields: [minuteRatePeriodId], references: [id])

  plannedQty  Int
  actualQty   Int?
  rejectedQty Int  @default(0)

  orderDate     DateTime  @db.Date
  plannedStart  DateTime? @db.Date
  plannedFinish DateTime? @db.Date
  actualStart   DateTime? @db.Date
  actualFinish  DateTime? @db.Date
  confirmedAt   DateTime?

  // --- planned vs actual: materials ---
  plannedFabricQty Decimal? @db.Decimal(18, 4)
  actualFabricQty  Decimal? @db.Decimal(18, 4)
  fabricVariance   Decimal? @db.Decimal(18, 4)

  // --- planned vs actual: minutes ---
  plannedSmvPerUnit Decimal? @db.Decimal(18, 4)
  actualSmvPerUnit  Decimal? @db.Decimal(18, 4)
  plannedTotalMinutes Decimal? @db.Decimal(18, 4)
  actualTotalMinutes  Decimal? @db.Decimal(18, 4)

  // --- planned vs actual: money ---
  plannedTotalCost Decimal? @db.Decimal(18, 4)
  actualTotalCost  Decimal? @db.Decimal(18, 4)
  costVariance     Decimal? @db.Decimal(18, 4)

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines            ProductionOrderLine[]
  cuttingTickets   CuttingTicket[]
  materialIssues   MaterialIssue[]
  stageLogs        ProductionStageLog[]
  qcRecords        QCRecord[]
  reworkRecords    ReworkRecord[]
  scrapRecords     ScrapRecord[]
  capacityBookings CapacityBooking[]
  inventoryLots    InventoryLot[]
  garmentUnits    GarmentUnit[]

  @@index([status, orderDate])
  @@index([styleId])
  customOrder CustomOrder?
  @@map("production_orders")
}

model ProductionOrderLine {
  id                String          @id @default(cuid())
  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  variantId         String
  variant           Variant         @relation(fields: [variantId], references: [id])
  plannedQty        Int
  actualQty         Int             @default(0)

  @@unique([productionOrderId, variantId])
  @@map("production_order_lines")
}

model CuttingTicket {
  id                String          @id @default(cuid())
  ticketNumber      String          @unique
  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  cutDate           DateTime        @db.Date
  markerLengthM     Decimal?        @db.Decimal(18, 4)
  plies              Int?
  piecesCut         Int
  notes             String?
  createdAt         DateTime        @default(now())

  issues MaterialIssue[]

  @@index([productionOrderId])
  @@map("cutting_tickets")
}

/// Where waste is measured:
///   actualWasteRate = (actualQty / standardQty) − 1
model MaterialIssue {
  id                String          @id @default(cuid())
  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  cuttingTicketId   String?
  cuttingTicket     CuttingTicket?  @relation(fields: [cuttingTicketId], references: [id], onDelete: SetNull)
  materialId        String
  material          Material        @relation(fields: [materialId], references: [id])

  issueDate       DateTime @db.Date
  /// What the BOM said this quantity of garments should need.
  standardQty     Decimal  @db.Decimal(18, 4)
  /// What the storeroom actually issued.
  actualQty       Decimal  @db.Decimal(18, 4)
  varianceQty     Decimal  @db.Decimal(18, 4)
  actualWasteRate Decimal  @db.Decimal(9, 6)
  /// Frozen at issue time from the FIFO lots consumed.
  unitCost        Decimal  @db.Decimal(18, 4)
  varianceValue   Decimal  @db.Decimal(18, 4)

  notes     String?
  createdAt DateTime @default(now())

  @@index([productionOrderId])
  @@index([materialId, issueDate])
  @@map("material_issues")
}

enum ScrapDisposition {
  SOLD
  DISCARDED
  USED_FOR_SAMPLING
  RETURNED_TO_STOCK
}

/// Offcuts and leftovers. Often a material sum of money — tracked, valued and
/// reconciled against fabric utilisation rather than quietly disappearing.
model ScrapRecord {
  id                String            @id @default(cuid())
  productionOrderId String?
  productionOrder   ProductionOrder?  @relation(fields: [productionOrderId], references: [id], onDelete: SetNull)
  materialId        String
  material          Material          @relation(fields: [materialId], references: [id])
  disposition       ScrapDisposition
  quantity          Decimal           @db.Decimal(18, 4)
  /// Book value of the scrapped material at FIFO cost.
  bookValue         Decimal           @db.Decimal(18, 4)
  /// Cash recovered if sold. Recovery rate = salvageValue / bookValue.
  salvageValue      Decimal           @default(0) @db.Decimal(18, 4)
  netLoss           Decimal           @db.Decimal(18, 4)
  scrapDate         DateTime          @db.Date
  notes             String?
  createdAt         DateTime          @default(now())

  @@index([materialId, scrapDate])
  @@index([productionOrderId])
  @@map("scrap_records")
}

/// Per-line, per-day throughput. Line efficiency = earnedMinutes / clockedMinutes.
model ProductionStageLog {
  id                String          @id @default(cuid())
  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  lineId            String?
  line              ProductionLine? @relation(fields: [lineId], references: [id], onDelete: SetNull)
  stage             ProductionStage
  logDate           DateTime        @db.Date

  qtyIn          Int
  qtyOut         Int
  operatorsCount Int?
  /// Minutes actually paid for on the line.
  clockedMinutes Decimal @db.Decimal(18, 4)
  /// qtyOut × SMV for this stage — minutes genuinely earned.
  earnedMinutes  Decimal @db.Decimal(18, 4)
  efficiencyRate Decimal @db.Decimal(9, 6)

  notes     String?
  createdAt DateTime @default(now())

  @@index([productionOrderId, stage])
  @@index([lineId, logDate])
  @@map("production_stage_logs")
}

model OperatorProductivity {
  id             String   @id @default(cuid())
  operatorId     String
  operator       Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  logDate        DateTime @db.Date
  smvProduced    Decimal  @db.Decimal(18, 4)
  clockedMinutes Decimal  @db.Decimal(18, 4)
  efficiencyRate Decimal  @db.Decimal(9, 6)
  notes          String?

  @@unique([operatorId, logDate])
  @@index([logDate])
  @@map("operator_productivity")
}

model QCRecord {
  id                String          @id @default(cuid())
  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  stage             ProductionStage @default(QC)
  inspectedQty      Int
  passedQty         Int
  reworkQty         Int             @default(0)
  rejectedQty       Int             @default(0)
  defectRate        Decimal         @db.Decimal(9, 6)
  defectNotes       String?
  inspectionDate    DateTime        @db.Date
  createdAt         DateTime        @default(now())

  @@index([productionOrderId])
  @@map("qc_records")
}

enum ReworkType {
  RESEWING
  REPRESSING
  REPACKING
  RECUTTING
  WASHING
}

/// Rework is real cost: extra minutes at the minute rate, plus any material.
model ReworkRecord {
  id                String          @id @default(cuid())
  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  lineId            String?
  line              ProductionLine? @relation(fields: [lineId], references: [id], onDelete: SetNull)
  type              ReworkType
  quantity          Int
  minutesPerUnit    Decimal         @db.Decimal(18, 4)
  totalMinutes      Decimal         @db.Decimal(18, 4)
  /// Frozen minute rate at the time of rework.
  minuteRate        Decimal         @db.Decimal(18, 8)
  labourCost        Decimal         @db.Decimal(18, 4)
  materialCost      Decimal         @default(0) @db.Decimal(18, 4)
  totalCost         Decimal         @db.Decimal(18, 4)
  reworkDate        DateTime        @db.Date
  reason            String?
  createdAt         DateTime        @default(now())

  @@index([productionOrderId])
  @@map("rework_records")
}

// ===========================================================================
// INVENTORY — FIFO lots across raw / WIP / finished goods
// ===========================================================================

enum LocationKind {
  FACTORY_WAREHOUSE
  SHOWROOM
  STORE
  /// Bazaars and exhibitions: stock goes out for a few days and must be
  /// reconciled back afterwards.
  EXHIBITION
  TRANSIT
}

/// Physical places stock can be. Configurable rather than an enum in code,
/// because new showrooms and events are a business decision, not a deploy.
model Location {
  id       String       @id @default(cuid())
  code     String       @unique
  nameEn   String
  nameAr   String
  kind     LocationKind
  entityId String?
  entity   Entity?      @relation(fields: [entityId], references: [id], onDelete: SetNull)
  city     String?
  /// Temporary locations (exhibitions) close after their event.
  isActive Boolean      @default(true)
  opensAt  DateTime?    @db.Date
  closesAt DateTime?    @db.Date
  sortOrder Int         @default(0)

  /// Where a temporary location's stock came from, and where whatever does
  /// not sell goes back to. Named explicitly rather than inferred from the
  /// movements, because a bazaar stocked from two branches must still return
  /// each garment to the branch that owns the shelf space for it.
  parentLocationId String?
  parent           Location?  @relation("LocationParent", fields: [parentLocationId], references: [id], onDelete: Restrict)
  children         Location[] @relation("LocationParent")

  inventoryLots     InventoryLot[]
  movementsFrom     InventoryMovement[] @relation("MovementFrom")
  movementsTo       InventoryMovement[] @relation("MovementTo")
  posSessions       PosSession[]
  salesOrders       SalesOrder[]
  garmentUnits      GarmentUnit[]

  customOrders     CustomOrder[]
  consignmentItems ConsignmentItem[]
  consignmentSales ConsignmentSale[]
  @@index([kind, isActive])
  @@index([parentLocationId])
  @@map("locations")
}

enum InventoryState {
  RAW_MATERIAL
  WIP
  FINISHED_GOODS
}

enum MovementType {
  RECEIPT
  ISSUE_TO_PRODUCTION
  PRODUCTION_OUTPUT
  SALE
  RETURN_IN
  SCRAP
  ADJUSTMENT
  TRANSFER
}

/// FIFO lot. Raw lots come from goods receipts; finished-goods lots come from
/// production output and carry the frozen transfer price as their unit cost.
/// What state a single garment is in. Distinct from its lot's state, because a
/// lot is a costing bucket and this is a physical object somebody can hold.
enum GarmentUnitStatus {
  /// Made, tagged, sitting at the factory.
  MADE
  /// Despatched to the Brand, not yet counted in.
  IN_TRANSIT
  /// On the Brand's floor and sellable.
  IN_STOCK
  SOLD
  /// Despatched and never arrived.
  LOST
  RETURNED
}

/// One physical garment.
///
/// Every piece carries its own code on its tag, so two black mediums off the
/// same run are told apart. That is what makes "which one was sold", "which
/// one came back" and "which three never arrived" answerable at all — none of
/// them are, when a whole size shares one barcode.
///
/// This sits alongside the lot rather than replacing it. Lots carry cost and
/// drive FIFO; units carry identity. Keeping them apart means the accounting
/// is unchanged by this existing at all.
model GarmentUnit {
  id     String @id @default(cuid())
  serial String @unique

  variantId String
  variant   Variant @relation(fields: [variantId], references: [id])

  /// The run it came off.
  productionOrderId String?
  productionOrder   ProductionOrder? @relation(fields: [productionOrderId], references: [id])

  /// The lot it currently belongs to, which changes as it moves between the
  /// two companies. Null once it is sold or written off.
  lotId String?
  lot   InventoryLot? @relation(fields: [lotId], references: [id], onDelete: SetNull)

  status GarmentUnitStatus @default(MADE)

  entityId   String?
  entity     Entity?   @relation(fields: [entityId], references: [id], onDelete: SetNull)
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  /// The order that sold it, so a specific garment traces to a specific sale.
  salesOrderLineId String?
  salesOrderLine   SalesOrderLine? @relation(fields: [salesOrderLineId], references: [id], onDelete: SetNull)

  /// Nothing reaches a shelf untagged; this records when it was.
  labelPrintedAt DateTime?
  soldAt         DateTime?
  /// Why it was written off, when it was.
  writeOffNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([variantId, status])
  @@index([status, locationId])
  @@index([lotId])
  @@index([productionOrderId])
  @@map("garment_units")
}

model InventoryLot {
  id        String         @id @default(cuid())
  lotNumber String         @unique
  state     InventoryState

  materialId String?
  material   Material? @relation(fields: [materialId], references: [id])
  variantId  String?
  variant    Variant?  @relation(fields: [variantId], references: [id])

  goodsReceiptLineId String?           @unique
  goodsReceiptLine   GoodsReceiptLine? @relation(fields: [goodsReceiptLineId], references: [id])
  productionOrderId  String?
  productionOrder    ProductionOrder?  @relation(fields: [productionOrderId], references: [id])

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: Restrict)

  /// Which entity's books this stock belongs to. The same SKU exists as
  /// factory finished goods and, after the transfer, as brand stock — at
  /// different costs.
  entityId String?
  entity   Entity? @relation(fields: [entityId], references: [id], onDelete: Restrict)

  originalQty  Decimal @db.Decimal(18, 4)
  remainingQty Decimal @db.Decimal(18, 4)
  /// Reserved for orders but not yet issued. Available = remaining − reserved.
  reservedQty  Decimal @default(0) @db.Decimal(18, 4)
  unitCost     Decimal @db.Decimal(18, 4)

  /// Breaks same-day receipt ties so FIFO order is total and deterministic.
  sequence Int @default(autoincrement())

  /// Factory profit sitting inside this lot's unit cost, set when stock is
  /// transferred to the Brand at transfer price. Group consolidation
  /// eliminates `remainingQty × transferMarginPerUnit`, because margin the
  /// group charged itself is not profit until the goods are sold outside.
  transferMarginPerUnit Decimal? @db.Decimal(18, 4)
  /// The costing this lot's transfer price came from, so the elimination is
  /// traceable back to its inputs.
  sourceCostSnapshotId  String?
  sourceCostSnapshot    CostSnapshot? @relation(fields: [sourceCostSnapshotId], references: [id], onDelete: SetNull)

  /// Aging clock starts here.
  receivedDate DateTime  @db.Date
  isDeadStock  Boolean   @default(false)
  deadStockFlaggedAt DateTime?

  /// When the shop tagged this batch. Nothing reaches a shelf untagged: a
  /// garment without a readable barcode is a garment the till cannot ring up
  /// and stocktake cannot count, so intake stamps this as it happens.
  labelsPrintedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements InventoryMovement[]

  // FIFO reads lots oldest-first within a material/variant and location, so
  // the index carries the sort key too.
  garmentUnits GarmentUnit[]
  @@index([state, receivedDate])
  @@index([materialId, locationId, receivedDate, sequence])
  @@index([variantId, locationId, receivedDate, sequence])
  @@map("inventory_lots")
}

/// The append-only stock ledger. Balances are always reconstructible from
/// these rows, so a lot's `remainingQty` is a cache that must agree with the
/// movements — never an independent source of truth.
model InventoryMovement {
  id        String       @id @default(cuid())
  lotId     String
  lot       InventoryLot @relation(fields: [lotId], references: [id], onDelete: Cascade)
  type      MovementType
  /// Always positive. `type` says whether stock came in or went out.
  quantity  Decimal      @db.Decimal(18, 4)
  unitCost  Decimal      @db.Decimal(18, 4)
  totalCost Decimal      @db.Decimal(18, 4)
  movementDate DateTime  @db.Date

  /// Both set only on a transfer; a receipt has no origin and an issue has no
  /// destination.
  fromLocationId String?
  fromLocation   Location? @relation("MovementFrom", fields: [fromLocationId], references: [id], onDelete: SetNull)
  toLocationId   String?
  toLocation     Location? @relation("MovementTo", fields: [toLocationId], references: [id], onDelete: SetNull)

  /// Every movement must name the document that caused it.
  referenceType String?
  referenceId   String?
  /// The journal this movement posted, so stock and the ledger stay tied.
  journalEntryId String?

  notes     String?
  createdAt DateTime @default(now())

  @@index([lotId])
  @@index([movementDate, type])
  @@index([referenceType, referenceId])
  @@map("inventory_movements")
}

// ===========================================================================
// MARKETING — campaigns, spend, attribution
//
// Marketing is a first-class Brand module because the spend materially
// changes whether a garment is profitable. Attribution never rewrites
// accounting: an order's revenue and cost are what they are, and a campaign
// link only says which effort is claiming credit for it.
// ===========================================================================

enum CampaignStatus {
  PLANNED
  RUNNING
  PAUSED
  FINISHED
}

enum AdPlatform {
  META
  GOOGLE
  TIKTOK
  INFLUENCER
  EMAIL
  WHATSAPP
  OTHER
}

model Campaign {
  id       String         @id @default(cuid())
  code     String         @unique
  nameEn   String
  nameAr   String
  status   CampaignStatus @default(PLANNED)
  platform AdPlatform     @default(META)

  objective String?
  audience  String?

  /// What the campaign is selling. Left open when it promotes the brand
  /// rather than one garment.
  collectionId String?
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  styleId      String?
  style        Style?      @relation(fields: [styleId], references: [id], onDelete: SetNull)

  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date
  budget    Decimal   @default(0) @db.Decimal(18, 4)

  /// The discount code that ties an order back to this campaign. Unique so a
  /// single order can never be claimed by two campaigns at once.
  couponCode String? @unique

  /// Influencer or agency fee, separate from platform ad spend.
  creatorName String?
  creatorFee  Decimal @default(0) @db.Decimal(18, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  spend       CampaignSpend[]
  salesOrders SalesOrder[]

  @@index([status, startDate])
  @@map("campaigns")
}

/// A day's spend on one campaign.
///
/// Recorded per day rather than as a running total so a campaign's cost can
/// be lined up against the orders it actually produced, and so a mistake can
/// be corrected without losing the rest.
model CampaignSpend {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  spendDate DateTime @db.Date
  amount    Decimal  @db.Decimal(18, 4)

  impressions Int @default(0)
  clicks      Int @default(0)
  /// Purchases the platform claims. Kept beside our own counted orders, never
  /// instead of them — the platform is marking its own homework.
  reportedConversions Int @default(0)

  /// The expense this spend was booked as, so the campaign reconciles to the
  /// ledger rather than living in a spreadsheet beside it.
  expenseId String?

  notes     String?
  createdAt DateTime @default(now())

  @@unique([campaignId, spendDate])
  @@index([spendDate])
  @@map("campaign_spend")
}

// ===========================================================================
// INTEGRATIONS — external systems
//
// An integration is never the accounting authority. Imported records become
// internal documents through the same services a human would use, and
// anything that cannot be matched lands in an exception queue instead of
// being guessed at.
// ===========================================================================

enum IntegrationProvider {
  SHOPIFY
  BIOMETRIC
  PAYMENT_GATEWAY
  BANK
}

/// Credentials and state for one external connection. The token is stored
/// here rather than in the environment so a shop can be reconnected without a
/// deploy — it must never be returned to the browser.
model IntegrationConnection {
  id        String              @id @default(cuid())
  provider  IntegrationProvider
  /// The shop domain, device serial or bank identifier.
  externalRef String
  displayName String

  accessToken String?
  /// Verifies signed webhooks, so a forged payload cannot inject orders.
  webhookSecret String?
  apiVersion  String?

  isActive     Boolean   @default(true)
  lastSyncedAt DateTime?
  lastError    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  syncLogs SyncLog[]
  mappings ExternalMapping[]

  @@unique([provider, externalRef])
  @@map("integration_connections")
}

enum SyncDirection {
  INBOUND
  OUTBOUND
}

enum SyncStatus {
  SUCCESS
  PARTIAL
  FAILED
}

/// One record per sync attempt, so a missing order can be traced to the run
/// that should have brought it in.
model SyncLog {
  id           String                @id @default(cuid())
  connectionId String
  connection   IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  objectType String
  direction  SyncDirection
  status     SyncStatus

  processed Int @default(0)
  created   Int @default(0)
  /// Records skipped because they had already been imported.
  duplicates Int @default(0)
  failed    Int @default(0)

  /// Failures in full, so a run can be retried against the same evidence.
  errors    Json?
  startedAt DateTime  @default(now())
  finishedAt DateTime?

  @@index([connectionId, startedAt])
  @@map("sync_logs")
}

/// Ties an external identifier to an internal record.
///
/// This is what makes an import idempotent: the same Shopify order arriving
/// twice finds its mapping and stops, rather than relieving stock again.
model ExternalMapping {
  id           String                @id @default(cuid())
  connectionId String
  connection   IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  objectType String
  externalId String
  internalId String
  /// Kept so a mismatch can be investigated against what the provider sent.
  externalRef String?

  createdAt DateTime @default(now())

  @@unique([connectionId, objectType, externalId])
  @@index([objectType, internalId])
  @@map("external_mappings")
}

/// A basket somebody filled and left.
///
/// The most useful marketing record the website produces: a named person, the
/// exact garments they wanted, what it was worth, and a link that puts it
/// back in front of them. Kept as its own record rather than an exception,
/// because nothing went wrong — the sale simply has not happened yet.
model AbandonedCheckout {
  id         String @id @default(cuid())
  connectionId String
  externalId String

  email       String?
  phone       String?
  customerName String?
  city        String?
  /// Matched to a known customer where possible, so their history is visible
  /// before anyone contacts them.
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  totalValue Decimal @db.Decimal(18, 4)
  itemCount  Int     @default(0)
  /// What was in the basket, kept verbatim: a follow-up that names the wrong
  /// garment is worse than none.
  lineItems  Json?

  /// Shopify's own link that restores the basket for the shopper.
  recoveryUrl String?

  abandonedAt DateTime
  lastSeenAt  DateTime @default(now())

  /// Set when the same person later buys, so nobody chases a completed sale.
  recoveredOrderId String?
  recoveredAt      DateTime?

  /// Records that someone has already been contacted, and how.
  contactedAt   DateTime?
  contactedVia  String?
  contactNote   String?

  createdAt DateTime @default(now())

  @@unique([connectionId, externalId])
  @@index([abandonedAt])
  @@index([recoveredOrderId])
  @@map("abandoned_checkouts")
}

enum ExceptionStatus {
  OPEN
  RESOLVED
  IGNORED
}

/// Something arrived that could not be processed automatically.
///
/// An unknown SKU on a website order is the common case. Guessing which
/// garment was meant would relieve the wrong stock, so the order waits here
/// for a person.
model IntegrationException {
  id           String          @id @default(cuid())
  connectionId String?
  provider     IntegrationProvider
  objectType   String
  externalId   String?
  reason       String
  /// The payload as received, so the decision is made on the real evidence.
  payload      Json?
  status       ExceptionStatus @default(OPEN)
  resolvedAt   DateTime?
  resolvedNote String?
  createdAt    DateTime        @default(now())

  @@index([status, provider])
  @@map("integration_exceptions")
}

// ===========================================================================
// HR — employees, attendance, payroll
//
// Biometric devices are an input source, not the accounting authority: raw
// punches are kept as evidence, and approved attendance is a separate,
// correctable record derived from them.
// ===========================================================================

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum PayFrequency {
  MONTHLY
  WEEKLY
  DAILY
  PIECE_RATE
}

model Employee {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  entityId  String
  entity    Entity   @relation(fields: [entityId], references: [id])
  /// Drives which cost pool the payroll lands in — a sewing operator's wage
  /// belongs in the factory conversion pool, a showroom assistant's does not.
  costCenterId String?
  costCenter   CostCenter? @relation(fields: [costCenterId], references: [id], onDelete: SetNull)

  department String?
  jobTitle   String?
  status     EmploymentStatus @default(ACTIVE)
  hiredAt    DateTime  @db.Date
  endedAt    DateTime? @db.Date

  payFrequency PayFrequency @default(MONTHLY)
  /// Current gross pay per period. History lives in SalaryHistory.
  baseSalary   Decimal      @db.Decimal(18, 4)

  phone String?
  /// National identifier. Sensitive: readable only with the salary capability.
  nationalId String?

  /// Device identifier used by the fingerprint reader, so punches can be
  /// mapped without coupling the employee record to one vendor's numbering.
  biometricDeviceUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  operator       Operator?
  salaryHistory  SalaryHistory[]
  punches        BiometricPunch[]
  attendance     AttendanceDay[]
  payrollLines   PayrollLine[]

  @@index([entityId, status])
  @@index([biometricDeviceUserId])
  @@map("employees")
}

/// Append-only. A pay rise never rewrites what a past payroll was based on.
model SalaryHistory {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  baseSalary Decimal  @db.Decimal(18, 4)
  effectiveFrom DateTime @db.Date
  reason     String?
  createdAt  DateTime @default(now())

  @@index([employeeId, effectiveFrom])
  @@map("salary_history")
}

/// Raw evidence from the device. Never edited, never deleted — a correction
/// is made on the derived attendance day, not on the punch.
model BiometricPunch {
  id         String   @id @default(cuid())
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  /// Kept even when no employee matches, so an unknown card surfaces as an
  /// exception instead of vanishing.
  deviceUserId String
  deviceId     String
  punchedAt    DateTime
  /// Vendor payload, retained verbatim for dispute resolution.
  rawPayload   Json?
  importedAt   DateTime @default(now())

  /// Device replays are common. The same device, badge and timestamp can only
  /// ever be stored once, which makes re-importing a file harmless.
  @@unique([deviceId, deviceUserId, punchedAt])
  @@index([employeeId, punchedAt])
  @@map("biometric_punches")
}

enum AttendanceSource {
  BIOMETRIC
  MANUAL
  IMPORTED
}

/// One approved day per employee. Derived from punches but independently
/// correctable, because a device failure must not become a pay dispute.
model AttendanceDay {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workDate   DateTime @db.Date

  firstIn  DateTime?
  lastOut  DateTime?
  /// Minutes actually present, after breaks.
  workedMinutes    Decimal @default(0) @db.Decimal(18, 4)
  /// Approved overtime only. Unapproved excess hours are visible but unpaid.
  overtimeMinutes  Decimal @default(0) @db.Decimal(18, 4)
  isAbsent   Boolean @default(false)
  isLeave    Boolean @default(false)
  leaveType  String?

  source     AttendanceSource @default(BIOMETRIC)
  /// Required whenever a day is corrected away from what the device recorded.
  adjustmentReason String?
  approvedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, workDate])
  @@index([workDate])
  @@map("attendance_days")
}

enum PayrollRunStatus {
  DRAFT
  APPROVED
  POSTED
}

/// A payroll run for one entity and month. Posting is what creates the
/// accrual; approval and posting are separate so preparation and release stay
/// segregated.
model PayrollRun {
  id             String           @id @default(cuid())
  runNumber      String           @unique
  entityId       String
  entity         Entity           @relation(fields: [entityId], references: [id])
  fiscalPeriodId String
  fiscalPeriod   FiscalPeriod     @relation(fields: [fiscalPeriodId], references: [id])
  status         PayrollRunStatus @default(DRAFT)

  grossPay     Decimal @default(0) @db.Decimal(18, 4)
  deductions   Decimal @default(0) @db.Decimal(18, 4)
  netPay       Decimal @default(0) @db.Decimal(18, 4)
  employerCost Decimal @default(0) @db.Decimal(18, 4)

  preparedByUserId String?
  approvedByUserId String?
  approvedAt       DateTime?
  postedAt         DateTime?
  /// The accrual journal, so payroll can be traced into the ledger.
  journalEntryId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines PayrollLine[]

  @@unique([entityId, fiscalPeriodId])
  @@index([status])
  @@map("payroll_runs")
}

model PayrollLine {
  id           String     @id @default(cuid())
  payrollRunId String
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     Employee   @relation(fields: [employeeId], references: [id])

  baseSalary      Decimal @db.Decimal(18, 4)
  overtimePay     Decimal @default(0) @db.Decimal(18, 4)
  /// Deduction for unpaid absence, computed from approved attendance.
  absenceDeduction Decimal @default(0) @db.Decimal(18, 4)
  otherDeductions  Decimal @default(0) @db.Decimal(18, 4)
  grossPay        Decimal @db.Decimal(18, 4)
  netPay          Decimal @db.Decimal(18, 4)
  /// Social insurance and other employer-side costs, on top of gross.
  employerCost    Decimal @default(0) @db.Decimal(18, 4)

  workedMinutes   Decimal @default(0) @db.Decimal(18, 4)
  overtimeMinutes Decimal @default(0) @db.Decimal(18, 4)
  absentDays      Int     @default(0)

  /// Which ledger account this person's pay lands in. Set from their cost
  /// centre so factory labour reaches the conversion pool exactly once.
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
  @@map("payroll_lines")
}

// ===========================================================================
// COMMERCIAL — channels, customers, sales, returns
// ===========================================================================

enum ChannelKind {
  ONLINE
  RETAIL_STORE
  WHOLESALE
  MARKETPLACE
}

model SalesChannel {
  id     String      @id @default(cuid())
  code   String      @unique
  nameEn String
  nameAr String
  kind   ChannelKind

  /// Payment cost differs sharply by channel: COD carries a per-order courier
  /// fee, cards a percentage.
  paymentFeePct   Decimal @default(0) @db.Decimal(9, 6)
  paymentFeeFixed Decimal @default(0) @db.Decimal(18, 4)
  shippingCostPerOrder Decimal @default(0) @db.Decimal(18, 4)

  /// Defaults used for unit economics until a style has its own history.
  defaultReturnRate   Decimal @default(0) @db.Decimal(9, 6)
  defaultDiscountRate Decimal @default(0) @db.Decimal(9, 6)
  /// Average days to collect cash — feeds the CCC.
  collectionDays      Int     @default(0)

  city     String?
  isActive Boolean @default(true)

  salesOrders SalesOrder[]
  customers   Customer[]
  settlements Settlement[]

  @@map("sales_channels")
}

model Customer {
  id        String        @id @default(cuid())
  code      String        @unique
  name      String
  channelId String?
  channel   SalesChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  phone     String?
  email     String?
  city      String?
  creditDays Int          @default(0)

  /// The most this customer may owe at any one time. Zero — the default —
  /// means no credit at all, which is the right starting point for somebody
  /// who walked in off the street. Raising it is a decision somebody makes
  /// about a person they know, so it lives on the customer rather than being
  /// a blanket policy.
  creditLimit Decimal     @default(0) @db.Decimal(18, 4)

  shopifyCustomerId String?
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())

  /// Where this customer first came from. Kept even after they buy through
  /// other channels, because acquisition source and current channel are
  /// different questions.
  acquiredVia OrderSource?

  /// Normalised for duplicate detection. Two Egyptian numbers written five
  /// different ways are one line; storing the normalised form makes that
  /// searchable without re-parsing on every query.
  phoneNormalised String?
  emailNormalised String?

  /// Marketing consent. Absence of a decision is not consent, so this stays
  /// null until the customer actually says.
  marketingConsent   Boolean?
  consentRecordedAt  DateTime?
  /// Suppressed customers are excluded from every campaign regardless of
  /// consent — an unsubscribe outranks an old opt-in.
  isSuppressed Boolean @default(false)

  /// Set when this record is confirmed to be a duplicate of another. The
  /// record is kept, never deleted, so its order history stays readable.
  mergedIntoId String?
  mergedInto   Customer?  @relation("CustomerMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom   Customer[] @relation("CustomerMerge")
  mergedAt     DateTime?

  notes String?

  salesOrders  SalesOrder[]
  journalLines JournalLine[]
  abandonedCheckouts AbandonedCheckout[]

  @@index([phoneNormalised])
  @@index([emailNormalised])
  @@index([mergedIntoId])
  customOrders CustomOrder[]
  consignmentSales ConsignmentSale[]
  @@map("customers")
}

enum SalesOrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

/// Where the order came from. Every Brand sale enters the same engine, but
/// attribution must survive: the website, a moderator's DM conversation and a
/// showroom till are different businesses to manage even when they sell the
/// same SKU from the same stock.
enum OrderSource {
  SHOPIFY
  MODERATOR
  POS
  EXHIBITION
  WHOLESALE
  MANUAL
}

/// A cashier's shift at a till. Cash is counted in at the start and out at the
/// end; the difference between counted and expected is a variance that must be
/// explained rather than absorbed.
model PosSession {
  id         String    @id @default(cuid())
  sessionNumber String @unique
  locationId String
  location   Location  @relation(fields: [locationId], references: [id])
  cashierUserId String
  cashier    User      @relation(fields: [cashierUserId], references: [id])

  openedAt   DateTime  @default(now())
  closedAt   DateTime?
  /// Who counted the drawer. Deliberately a different person from the
  /// cashier: whoever took the money does not get to declare it correct.
  closedByUserId String?
  closedBy       User?   @relation("PosSessionClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)
  openingFloat Decimal @db.Decimal(18, 4)
  /// Counted in the drawer at close. Null until the shift is closed.
  countedCash  Decimal? @db.Decimal(18, 4)
  /// Opening float plus cash sales, as the system believes it.
  expectedCash Decimal? @db.Decimal(18, 4)
  cashVariance Decimal? @db.Decimal(18, 4)
  varianceNote String?

  orders SalesOrder[]
  consignmentSales ConsignmentSale[]

  @@index([locationId, openedAt])
  @@index([closedByUserId])
  @@map("pos_sessions")
}

model SalesOrder {
  id          String           @id @default(cuid())
  orderNumber String           @unique
  channelId   String
  channel     SalesChannel     @relation(fields: [channelId], references: [id])
  customerId  String?
  customer    Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status      SalesOrderStatus @default(PENDING)

  source OrderSource @default(MANUAL)

  /// Which entity's books the sale belongs to. Brand for retail; the factory
  /// uses this for external CMT invoicing.
  entityId String?
  entity   Entity? @relation(fields: [entityId], references: [id], onDelete: SetNull)

  /// Who entered it — the moderator or the cashier. Null for machine imports.
  createdByUserId String?
  createdBy       User?   @relation("SalesOrderCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  /// Where stock is relieved from. Online orders normally ship from the
  /// Alexandria warehouse; POS sells from the till's own location.
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  posSessionId String?
  posSession   PosSession? @relation(fields: [posSessionId], references: [id], onDelete: SetNull)

  /// Which marketing effort is claiming credit for this order. Attribution
  /// never changes the order's revenue or cost — it only says who claims it.
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  orderDate     DateTime  @db.Date
  shippedDate   DateTime? @db.Date
  deliveredDate DateTime? @db.Date
  /// When cash actually landed — feeds collection days in the CCC.
  collectedDate DateTime? @db.Date
  /// When the unpaid balance falls due, from the customer's agreed terms.
  /// Set only when the customer left owing something, so an aging report can
  /// separate "late" from "not yet due" rather than treating all debt alike.
  dueDate       DateTime? @db.Date

  grossAmount    Decimal @db.Decimal(18, 4)
  discountAmount Decimal @default(0) @db.Decimal(18, 4)
  netAmount      Decimal @db.Decimal(18, 4)
  shippingAmount Decimal @default(0) @db.Decimal(18, 4)
  paymentFee     Decimal @default(0) @db.Decimal(18, 4)
  /// FIFO cost of everything relieved for this order.
  cogsAmount     Decimal @default(0) @db.Decimal(18, 4)

  /// The external system's own id. Unique per source so re-importing the same
  /// Shopify order can never create a duplicate.
  externalId     String?
  shopifyOrderId String?  @unique

  city           String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lines    SalesOrderLine[]
  returns  Return[]
  payments SalesPayment[]

  @@unique([source, externalId])
  @@index([channelId, orderDate])
  customOrder CustomOrder?
  @@index([status])
  @@index([source, orderDate])
  @@index([createdByUserId])
  /// Every customer screen asks for one person's history out of all of them.
  /// Without this it reads the whole order table to find a handful of rows.
  @@index([customerId, orderDate])
  @@index([dueDate])
  @@map("sales_orders")
}

enum PaymentMethod {
  CASH
  CARD
  COD
  BANK_TRANSFER
  /// InstaPay. Lands in the bank the same day, so it is treated as a transfer
  /// that has already arrived rather than as something in a clearing account.
  INSTAPAY
  /// Kept only because Postgres cannot drop an enum value cleanly and old
  /// rows may reference it. Not offered anywhere: this shop holds no wallet
  /// balances for customers.
  WALLET
  STORE_CREDIT
  /// Money the customer paid before the garment existed. It sat as a
  /// liability from the day it was taken; settling the sale with it clears
  /// that liability rather than bringing new cash in, which already arrived.
  DEPOSIT
}

enum PaymentStatus {
  PENDING
  COLLECTED
  FAILED
  REFUNDED
}

/// Money against an order. Separate from the order because one sale can be
/// split across methods, and because a cash-on-delivery order is not cash
/// until the courier actually hands it over.
model SalesPayment {
  id           String        @id @default(cuid())
  salesOrderId String
  salesOrder   SalesOrder    @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  method       PaymentMethod
  status       PaymentStatus @default(PENDING)
  amount       Decimal       @db.Decimal(18, 4)
  /// Processor or courier fee on this payment.
  fee          Decimal       @default(0) @db.Decimal(18, 4)
  reference    String?
  collectedAt  DateTime?
  createdAt    DateTime      @default(now())
  settlementLine SettlementLine?

  @@index([salesOrderId])
  @@index([status, method])
  @@map("sales_payments")
}

/// `discountPct` on the line is what drives markdown analysis — the split
/// between full-price, lightly discounted and heavily discounted units.
model SalesOrderLine {
  id           String     @id @default(cuid())
  salesOrderId String
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  variantId    String
  variant      Variant    @relation(fields: [variantId], references: [id])

  quantity     Int
  retailPrice  Decimal @db.Decimal(18, 4)
  discountPct  Decimal @default(0) @db.Decimal(9, 6)
  netPrice     Decimal @db.Decimal(18, 4)
  lineTotal    Decimal @db.Decimal(18, 4)
  /// FIFO cost of goods relieved for this line.
  unitCost     Decimal @db.Decimal(18, 4)
  lineCost     Decimal @db.Decimal(18, 4)

  garmentUnits GarmentUnit[]

  @@index([salesOrderId])
  @@index([variantId])
  @@map("sales_order_lines")
}

enum ReturnDisposition {
  RESTOCK
  WRITE_OFF
  REPAIR_AND_RESTOCK
}

model Return {
  id           String            @id @default(cuid())
  returnNumber String            @unique
  salesOrderId String
  salesOrder   SalesOrder        @relation(fields: [salesOrderId], references: [id])
  variantId    String
  variant      Variant           @relation(fields: [variantId], references: [id])
  quantity     Int
  reason       String?
  disposition  ReturnDisposition @default(RESTOCK)
  handlingCost Decimal           @default(0) @db.Decimal(18, 4)
  refundAmount Decimal           @db.Decimal(18, 4)
  returnDate   DateTime          @db.Date
  createdAt    DateTime          @default(now())

  @@index([salesOrderId])
  @@index([returnDate])
  @@map("returns")
}

// ===========================================================================
// EXTERNAL CMT — the lever on idle capacity
// ===========================================================================

model CMTClient {
  id         String  @id @default(cuid())
  code       String  @unique
  name       String
  contactPerson String?
  phone      String?
  email      String?
  creditDays Int     @default(0)

  /// The smallest run this particular client may place. Null means the house
  /// minimum applies. Set per client because a long-standing customer bringing
  /// repeat work is worth taking a short run for, and a stranger is not.
  minimumQuantity Int?

  isActive   Boolean @default(true)
  notes      String?
  createdAt  DateTime @default(now())

  quotes CMTQuote[]
  orders CMTOrder[]

  @@map("cmt_clients")
}

enum CMTQuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

/// Hard rule: `quotedMinuteRate` may never fall below the period's
/// `fullCapacityMinuteRate`. Below that, the quote does not even recover
/// overhead at full capacity and every minute sold makes things worse.
/// Somebody wants a garment the shop does not have and the factory can make.
///
/// Kept apart from SalesOrder on purpose: there is nothing to sell yet. No
/// stock exists, so nothing can be relieved and no revenue can be recognised.
/// A deposit taken today is money held against a promise — a liability — and
/// only becomes revenue on the day the customer walks out with the garment.
/// The SalesOrder is created then, and not before.

/// Somebody else's brand, selling through this shop.
///
/// Not a Supplier: a supplier sells the shop goods, and those goods become
/// the shop's. A consignor keeps ownership until the garment is sold, and
/// what the shop owes them appears only when it is.
model Consignor {
  id       String  @id @default(cuid())
  code     String  @unique
  name     String
  contactPerson String?
  phone    String?
  email    String?

  /// The shop's share, as a fraction. 0.25 is twenty-five per cent.
  commissionRate Decimal @db.Decimal(9, 6)
  /// Days after a sale before the owner expects their money.
  settlementDays Int     @default(0)

  isActive Boolean @default(true)
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items       ConsignmentItem[]
  settlements ConsignorSettlement[]

  @@map("consignors")
}

/// A garment held on consignment.
///
/// Deliberately not an InventoryLot. Lots are what the business owns, and
/// every stock valuation, GMROI figure and dead-stock report reads them
/// without asking whose they are. Putting somebody else's goods in that table
/// would mean every one of those queries needed a filter, and the first one
/// that forgot would overstate what the business owns.
model ConsignmentItem {
  id          String @id @default(cuid())
  itemCode    String @unique
  consignorId String
  consignor   Consignor @relation(fields: [consignorId], references: [id], onDelete: Restrict)

  description String
  /// Free text: it is not the shop's size and colour vocabulary.
  size        String?
  colour      String?

  /// What it is sold for. The owner sets it; the shop takes a share of it.
  retailPrice Decimal @db.Decimal(18, 4)
  /// Overrides the consignor's rate for this piece, when one was agreed.
  commissionRate Decimal? @db.Decimal(9, 6)

  quantityReceived Int
  quantitySold     Int @default(0)
  /// Given back to the owner unsold.
  quantityReturned Int @default(0)

  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  receivedDate DateTime  @db.Date
  /// After this the owner wants them back, sold or not.
  expiresAt    DateTime? @db.Date

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales ConsignmentSale[]

  @@index([consignorId])
  @@index([locationId])
  @@map("consignment_items")
}

/// One consigned garment leaving the shop.
///
/// Kept apart from SalesOrder because almost nothing about it is the same:
/// no stock is relieved, no cost of sales arises, and the revenue is the
/// commission rather than the price on the ticket.
model ConsignmentSale {
  id         String @id @default(cuid())
  saleNumber String @unique

  itemId String
  item   ConsignmentItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  quantity   Int
  /// What the customer actually paid, which may be under the ticket price.
  soldPrice  Decimal @db.Decimal(18, 4)
  /// Frozen at the sale: a rate change later must not rewrite what was owed.
  commissionRate   Decimal @db.Decimal(9, 6)
  commissionAmount Decimal @db.Decimal(18, 4)
  /// Sale value less commission — the owner's money.
  ownerAmount      Decimal @db.Decimal(18, 4)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  entityId   String
  entity     Entity   @relation(fields: [entityId], references: [id], onDelete: Restrict)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  posSessionId String?
  posSession   PosSession? @relation(fields: [posSessionId], references: [id], onDelete: SetNull)

  paymentMethod PaymentMethod
  saleDate      DateTime @db.Date

  /// Set once the owner has been paid for this sale.
  settlementId String?
  settlement   ConsignorSettlement? @relation(fields: [settlementId], references: [id], onDelete: SetNull)

  soldByUserId String?
  soldBy       User?   @relation("ConsignmentSoldBy", fields: [soldByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([itemId])
  @@index([saleDate])
  @@index([settlementId])
  @@map("consignment_sales")
}

/// Paying a consignor what the shop has collected on their behalf.
model ConsignorSettlement {
  id               String @id @default(cuid())
  settlementNumber String @unique

  consignorId String
  consignor   Consignor @relation(fields: [consignorId], references: [id], onDelete: Restrict)

  /// Sum of the owner's share across the sales it covers.
  amount     Decimal @db.Decimal(18, 4)
  method     PaymentMethod
  paidOn     DateTime @db.Date
  reference  String?
  notes      String?

  entityId String
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Restrict)

  paidByUserId String?
  paidBy       User?   @relation("ConsignorSettlementPaidBy", fields: [paidByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  sales ConsignmentSale[]

  @@index([consignorId, paidOn])
  @@map("consignor_settlements")
}

model CustomOrder {
  id          String            @id @default(cuid())
  orderNumber String            @unique
  status      CustomOrderStatus @default(PENDING)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  /// Exactly what they asked for: style, colour and size.
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity  Int

  agreedUnitPrice Decimal @db.Decimal(18, 4)
  agreedTotal     Decimal @db.Decimal(18, 4)
  /// Taken up front and held as a liability until the garment is handed over.
  depositAmount   Decimal @default(0) @db.Decimal(18, 4)

  entityId   String
  entity     Entity   @relation(fields: [entityId], references: [id], onDelete: Restrict)
  /// Where the customer will collect it.
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  /// The run raised to make it. One custom order, one run: a bespoke piece
  /// is not batched with the season's production.
  productionOrderId String?          @unique
  productionOrder   ProductionOrder? @relation(fields: [productionOrderId], references: [id], onDelete: SetNull)

  /// Set the day it is handed over, which is the day it becomes a sale.
  salesOrderId String?     @unique
  salesOrder   SalesOrder? @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)

  promisedDate DateTime? @db.Date
  deliveredAt  DateTime? @db.Date
  cancelledAt  DateTime? @db.Date
  cancelReason String?

  notes           String?
  createdByUserId String?
  createdBy       User?   @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, status])
  @@index([status, promisedDate])
  @@map("custom_orders")
}

enum CustomOrderStatus {
  /// Agreed with the customer, nothing made yet.
  PENDING
  /// A production run has been raised against it.
  IN_PRODUCTION
  /// Made and waiting on the customer.
  READY
  /// Handed over. There is a SalesOrder from this point on.
  DELIVERED
  CANCELLED
}

model CMTQuote {
  id          String         @id @default(cuid())
  quoteNumber String         @unique
  clientId    String
  client      CMTClient      @relation(fields: [clientId], references: [id])
  minuteRatePeriodId String
  minuteRatePeriod   MinuteRatePeriod @relation(fields: [minuteRatePeriodId], references: [id])
  status      CMTQuoteStatus @default(DRAFT)

  styleDescription String
  quantity         Int
  smvPerUnit       Decimal @db.Decimal(18, 4)
  totalMinutes     Decimal @db.Decimal(18, 4)

  /// Frozen floor at quote time.
  floorMinuteRate  Decimal @db.Decimal(18, 8)
  quotedMinuteRate Decimal @db.Decimal(18, 8)
  marginOverFloorPct Decimal @db.Decimal(9, 6)
  quotedUnitPrice  Decimal @db.Decimal(18, 4)
  quotedTotal      Decimal @db.Decimal(18, 4)

  validUntil DateTime? @db.Date
  quoteDate  DateTime  @db.Date
  notes      String?
  createdAt  DateTime  @default(now())

  orders CMTOrder[]

  @@index([clientId])
  @@map("cmt_quotes")
}

enum CMTOrderStatus {
  CONFIRMED
  IN_PRODUCTION
  COMPLETED
  CANCELLED
}

model CMTOrder {
  id          String         @id @default(cuid())
  orderNumber String         @unique
  clientId    String
  client      CMTClient      @relation(fields: [clientId], references: [id])
  quoteId     String?
  quote       CMTQuote?      @relation(fields: [quoteId], references: [id])
  status      CMTOrderStatus @default(CONFIRMED)

  quantity        Int
  smvPerUnit      Decimal @db.Decimal(18, 4)
  totalMinutes    Decimal @db.Decimal(18, 4)
  agreedMinuteRate Decimal @db.Decimal(18, 8)
  contractValue   Decimal @db.Decimal(18, 4)

  actualMinutes  Decimal? @db.Decimal(18, 4)
  actualCost     Decimal? @db.Decimal(18, 4)
  realisedMargin Decimal? @db.Decimal(18, 4)

  orderDate    DateTime  @db.Date
  dueDate      DateTime? @db.Date
  completedAt  DateTime? @db.Date
  createdAt    DateTime  @default(now())

  capacityBookings CapacityBooking[]

  @@index([clientId, orderDate])
  @@map("cmt_orders")
}

// ===========================================================================
// CASH FLOW FORECAST
// ===========================================================================

enum CashDirection {
  INFLOW
  OUTFLOW
}

enum CashItemFrequency {
  ONE_OFF
  MONTHLY
  QUARTERLY
  ANNUAL
}

/// Recurring known cash items (payroll, rent, instalments) that have no
/// invoice yet but will absolutely need funding. Combined with expense due
/// dates, PO commitments and expected receivables to build the forecast.
model ScheduledCashItem {
  id             String            @id @default(cuid())
  entityId       String
  entity         Entity            @relation(fields: [entityId], references: [id])
  costCategoryId String?
  costCategory   CostCategory?     @relation(fields: [costCategoryId], references: [id], onDelete: SetNull)
  nameEn         String
  nameAr         String
  direction      CashDirection
  amount         Decimal           @db.Decimal(18, 4)
  frequency      CashItemFrequency @default(MONTHLY)
  /// Day of month the cash actually moves.
  dayOfMonth     Int               @default(1)
  startDate      DateTime          @db.Date
  endDate        DateTime?         @db.Date
  isActive       Boolean           @default(true)

  @@index([entityId, isActive])
  @@map("scheduled_cash_items")
}

// ===========================================================================
// ALERTS — the system tells you, you don't go looking
// ===========================================================================

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  SNOOZED
}

model AlertRule {
  id          String        @id @default(cuid())
  code        String        @unique
  nameEn      String
  nameAr      String
  descriptionEn String?
  descriptionAr String?
  severity    AlertSeverity @default(WARNING)
  /// Rule parameters (thresholds, windows) — configurable, never hardcoded.
  parameters  Json
  isEnabled   Boolean       @default(true)
  lastRunAt   DateTime?

  alerts Alert[]

  @@map("alert_rules")
}

model Alert {
  id          String        @id @default(cuid())
  alertRuleId String
  alertRule   AlertRule     @relation(fields: [alertRuleId], references: [id], onDelete: Cascade)
  severity    AlertSeverity
  status      AlertStatus   @default(OPEN)

  titleEn String
  titleAr String
  bodyEn  String
  bodyAr  String

  /// What the alert is about, for deep-linking.
  subjectType String?
  subjectId   String?
  /// The numbers that triggered it, for the drill-down.
  metrics     Json?

  /// Deduplication key so the same condition doesn't re-alert every morning.
  dedupeKey String

  acknowledgedByUserId String?
  acknowledgedBy       User?     @relation("AlertAcknowledgedBy", fields: [acknowledgedByUserId], references: [id], onDelete: SetNull)
  acknowledgedAt       DateTime?
  resolvedAt           DateTime?
  snoozedUntil         DateTime?

  createdAt DateTime @default(now())

  @@unique([alertRuleId, dedupeKey])
  @@index([status, severity, createdAt])
  @@map("alerts")
}

// ===========================================================================
// SCENARIO SIMULATOR — "what if"
// ===========================================================================

/// Scenarios never write to operational tables. They read the current state,
/// apply overrides in memory, and store the resulting comparison.
model Scenario {
  id            String   @id @default(cuid())
  name          String
  descriptionEn String?
  descriptionAr String?
  createdByUserId String?
  createdBy       User?  @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  /// e.g. { "fabricPriceDeltaPct": 0.10, "utilisationRate": 0.85,
  ///        "returnRate": 0.12, "discountRate": 0.20,
  ///        "wageDeltaPct": 0.15, "marketingDeltaPct": 0.30 }
  assumptions Json
  /// Which fiscal period the baseline was drawn from.
  baselinePeriodId String?

  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  results ScenarioResult[]

  @@map("scenarios")
}

model ScenarioResult {
  id         String   @id @default(cuid())
  scenarioId String
  scenario   Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  metricKey   String
  labelEn     String
  labelAr     String
  baseline    Decimal  @db.Decimal(18, 4)
  simulated   Decimal  @db.Decimal(18, 4)
  delta       Decimal  @db.Decimal(18, 4)
  deltaPct    Decimal? @db.Decimal(9, 6)
  unit        String   @default("EGP")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([scenarioId])
  @@map("scenario_results")
}

// ===========================================================================
// RECONCILIATION — proving the books against what the bank and the couriers
// actually did
// ===========================================================================

enum SettlementProvider {
  COURIER
  PAYMENT_GATEWAY
}

enum SettlementStatus {
  DRAFT
  POSTED
}

/// A remittance from a courier or a card processor.
///
/// Money taken on the customer's doorstep is the courier's until they pay it
/// over, which is why it sits in a clearing account rather than in cash. This
/// is the document that clears it: the operator ticks the orders the
/// remittance covers, and anything not ticked stays outstanding and visible
/// instead of being quietly absorbed into a total that looked about right.
model Settlement {
  id               String             @id @default(cuid())
  settlementNumber String             @unique
  provider         SettlementProvider
  channelId        String?
  channel          SalesChannel?      @relation(fields: [channelId], references: [id], onDelete: SetNull)
  entityId         String
  entity           Entity             @relation(fields: [entityId], references: [id])

  /// The courier's own batch number, so a query can be traced back to them.
  reference      String?
  settlementDate DateTime @db.Date

  /// What the ticked payments should have brought in, net of the fees already
  /// booked when the sale was recorded.
  expectedAmount Decimal @db.Decimal(18, 4)
  /// What actually landed in the bank.
  netReceived    Decimal @db.Decimal(18, 4)
  /// netReceived − expectedAmount. Negative means they paid short.
  variance       Decimal @db.Decimal(18, 4)
  varianceNote   String?

  status         SettlementStatus @default(DRAFT)
  journalEntryId String?
  postedAt       DateTime?

  createdByUserId String?
  createdBy       User?   @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())

  lines SettlementLine[]

  @@index([provider, settlementDate])
  @@index([status])
  @@map("settlements")
}

model SettlementLine {
  id           String     @id @default(cuid())
  settlementId String
  settlement   Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  /// One payment can only be settled once, which the database enforces rather
  /// than the screen: the same batch pasted in twice would otherwise clear the
  /// same money against the bank twice.
  salesPaymentId String       @unique
  salesPayment   SalesPayment @relation(fields: [salesPaymentId], references: [id])

  expectedAmount Decimal @db.Decimal(18, 4)

  @@index([settlementId])
  @@map("settlement_lines")
}

enum BankLineStatus {
  UNMATCHED
  MATCHED
  /// Real, but with no counterpart in the books yet — a bank charge nobody
  /// recorded. Kept apart from matched so it stays on somebody's list.
  EXPLAINED
}

/// A period of a bank account as the bank reports it.
model BankStatement {
  id String @id @default(cuid())

  /// The chart account this statement belongs to, by code rather than id so a
  /// statement is readable without a join.
  accountCode String
  entityId    String
  entity      Entity @relation(fields: [entityId], references: [id])

  statementDate  DateTime @db.Date
  openingBalance Decimal  @db.Decimal(18, 4)
  closingBalance Decimal  @db.Decimal(18, 4)
  reference      String?

  createdByUserId String?
  createdBy       User?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())

  lines BankStatementLine[]

  @@index([accountCode, statementDate])
  @@map("bank_statements")
}

model BankStatementLine {
  id              String        @id @default(cuid())
  bankStatementId String
  bankStatement   BankStatement @relation(fields: [bankStatementId], references: [id], onDelete: Cascade)

  valueDate   DateTime @db.Date
  description String
  reference   String?
  /// Signed: positive money in, negative money out. One column rather than
  /// two, because a bank line is one movement and splitting it invites a row
  /// with both filled in.
  amount      Decimal  @db.Decimal(18, 4)

  status              BankLineStatus @default(UNMATCHED)
  matchedJournalLineId String?       @unique
  matchedJournalLine   JournalLine?  @relation(fields: [matchedJournalLineId], references: [id], onDelete: SetNull)
  note                String?

  @@index([bankStatementId, status])
  @@map("bank_statement_lines")
}
