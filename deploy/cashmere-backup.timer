# Runs the backup nightly.
#
# 03:00 Cairo: the shop is closed, nobody is posting, and a dump taken then is
# a clean picture of a finished day rather than half of a live one.
#
# The zone is named rather than assumed. The server's clock is UTC, so a bare
# 03:00 here would fire at five or six in the morning Cairo time depending on
# the season — close enough to look right and wrong twice a year.

[Unit]
Description=Nightly Cashmere OS backup

[Timer]
OnCalendar=*-*-* 03:00:00 Africa/Cairo
# If the server was off at 03:00 — a reboot, a power cut — run on the next
# start rather than skipping silently until tomorrow.
Persistent=true
# So every machine does not hit the disk at the same instant.
RandomizedDelaySec=5min

[Install]
WantedBy=timers.target
